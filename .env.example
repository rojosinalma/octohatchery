# Copy to .env (0600) and fill in. Bun loads this file itself; compose does not read it.

PORT=3000                                   # HTTP port of the app
MODE=single                                 # single (SQLite or Postgres) | cluster (Postgres required, several nodes)
DATABASE_URL=sqlite:./data/octohatchery.db  # or postgres://user:pass@host:5432/octohatchery?sslmode=require
DATABASE_SCHEMA=                            # postgres only: schema for the tables and migrations; empty = octohatchery (or public, when the tables are already there)
HOST_NAME=                                  # this node's name as runners and slots see it; default: the OS hostname
DOCKER_HOST=                                # container engine; default: the local unix socket (/var/run/docker.sock)
CONTAINER_BACKEND=docker                    # docker | fake (tests only)
RUNNER_NETWORK=octohatchery_default         # docker network runners join (must reach octohatchery-buildkitd)
DATA_DIR=./data                             # SQLite file and other local state
DIND_CERTS_DIR=                             # optional: host folder like /etc/docker/certs.d (<registry>/ca.crt), mounted read-only into every Docker-in-Docker daemon so it trusts private registries

GITHUB_AUTH=app                             # app | pat | none (tests only)
GITHUB_APP_ID=                              # app mode: numeric App id
GITHUB_APP_PRIVATE_KEY=                     # app mode: PEM, newlines as \n on one line
GITHUB_APP_INSTALLATION_ID=                 # app mode, optional: the default installation; empty = discover every installation (see github_accounts)
GITHUB_TOKEN=                               # pat mode: fine-grained token with Actions + Administration + Contents + Pull requests
GITHUB_WEBHOOK_SECRET=                      # shared secret GitHub signs workflow_job deliveries with (required unless GITHUB_AUTH=none)
PUBLIC_URL=https://octohatchery.example.com # public base URL; webhooks go to $PUBLIC_URL/webhooks/github
OCTOFORGE_TOKEN=                            # optional: bearer for the Octoforge member API (/api/octoforge); empty = those routes do not exist. See docs/octoforge.md

APP_MEM=1g                                  # compose: app container memory limit (bin/verify's typecheck needs ~700 MB)
BUILDKIT_MEM=2g                             # compose: buildkitd memory limit
BUILDKIT_CPUS=2                             # compose: buildkitd CPU limit
PROJECT_DIR=.                               # compose: host path of this checkout, mounted at /app
DOCKER_GID=999                              # compose: gid of /var/run/docker.sock on this host (stat -c %g /var/run/docker.sock)
INGRESS_NETWORK=ingress                     # compose: external network of your reverse proxy (delete the network from compose.yaml to run standalone)
POSTGRES_NETWORK=postgres                   # compose: external network where PostgreSQL lives (delete it when the database is elsewhere)
LOCAL_REGISTRY=                             # bin/release-local: registry that image-based nodes pull from (empty = ghcr only)

# Secret env names referenced by runner types are read from this file at spawn time, e.g.
# DEPLOYER_TOKEN=                           # used by the default `deploy` runner type
