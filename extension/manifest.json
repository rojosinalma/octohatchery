{
  "manifest_version": 3,
  "name": "OctoHatchery",
  "short_name": "OctoHatchery",
  "description": "Running, queued and finished jobs of your OctoHatchery at a glance, with alerts and toolbar counters.",
  "version": "0.0.0",
  "homepage_url": "https://github.com/rojosinalma/octohatchery",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "OctoHatchery",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["storage", "alarms", "notifications"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  }
}
