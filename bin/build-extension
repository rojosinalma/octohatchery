#!/usr/bin/env bun
// Builds the browser extension from extension/ plus the vendored tailor files in public/tailor/.
// Usage: bin/build-extension [--no-zip] [--crx] [out-dir]   (default: dist/extension)
//   --no-zip  skips the zips (they need `zip`)
//   --crx     also packs a signed Chrome .crx (needs Chrome or Chromium). The signing key is
//             EXTENSION_KEY, else .git/info/extension-key.pem; a missing key file is created. Keep it: the key
//             fixes the extension ID, and a new key means a new extension to Chrome (and its settings start empty).
// Writes, with no version in any file name (unzip over the old folder, then reload the extension):
//   <out>/chrome/octohatchery-extension/      unpacked Chrome build (load this folder)
//   <out>/octohatchery-extension-chrome.zip   that folder, zipped with the folder at its root
//   <out>/firefox/                            unpacked Firefox build
//   <out>/octohatchery-extension-firefox.zip  Firefox build, files at the root (about:debugging loads it as is)
//   <out>/octohatchery-extension.crx          with --crx: the Chrome build, signed
//   <out>/policy/                             scripts that let a browser install the .crx (Linux, Windows, macOS),
//                                             with the extension ID filled in when the key file exists
// When the key file exists, the Chrome manifest carries its public key, so the unpacked folder and the .crx
// get the same extension ID wherever they are loaded from.
import { $ } from 'bun'
import { createHash, createPublicKey, generateKeyPairSync } from 'node:crypto'
import { chmodSync, cpSync, existsSync, mkdirSync, readdirSync, readFileSync, renameSync, rmSync, writeFileSync } from 'node:fs'
import { homedir, tmpdir } from 'node:os'
import { join, resolve } from 'node:path'

const root = resolve(import.meta.dir, '..')
const args = process.argv.slice(2)
const noZip = args.includes('--no-zip')
const crx = args.includes('--crx')
const out = resolve(args.find((a) => !a.startsWith('--')) ?? join(root, 'dist/extension'))
const src = join(root, 'extension')
const tailor = join(root, 'public/tailor')
const pkg = JSON.parse(readFileSync(join(root, 'package.json'), 'utf8'))
const NAME = 'octohatchery-extension'
/** Firefox needs a fixed add-on id for storage.sync; this one is a placeholder until the add-on is listed. */
const GECKO_ID = 'octohatchery-extension@rojosinalma.github.io'

// The pre-paint config of the vendored head snippet, with paths relative to the extension pages.
const head = readFileSync(join(tailor, 'tailor-head.html'), 'utf8')
const m = /var C=(\{.*?\});var P=/s.exec(head)
if (!m) throw new Error('public/tailor/tailor-head.html: no tailor config found')
const config = { ...JSON.parse(m[1]!), project: NAME, base: 'tailor/' }

// Signing key: created on the first --crx build; its public key goes into the Chrome manifest.
const keyPath = resolve(process.env.EXTENSION_KEY || join(root, (await $`git rev-parse --git-path info/extension-key.pem`.cwd(root).quiet().nothrow().text()).trim() || '.git/info/extension-key.pem'))
if (crx && !existsSync(keyPath)) {
  const { privateKey } = generateKeyPairSync('rsa', { modulusLength: 2048 })
  writeFileSync(keyPath, privateKey.export({ type: 'pkcs8', format: 'pem' }), { mode: 0o600 })
  chmodSync(keyPath, 0o600)
  console.log(`created the signing key ${keyPath} (keep a copy: it fixes the extension ID)`)
}
let publicKey = ''
let extensionId = ''
if (existsSync(keyPath)) {
  const der = createPublicKey(readFileSync(keyPath, 'utf8')).export({ type: 'spki', format: 'der' })
  publicKey = der.toString('base64')
  extensionId = [...createHash('sha256').update(der).digest('hex').slice(0, 32)].map((c) => String.fromCharCode(97 + parseInt(c, 16))).join('')
}

const manifest = JSON.parse(readFileSync(join(src, 'manifest.json'), 'utf8'))
manifest.version = String(pkg.version).replace(/[^0-9.].*$/, '')

function assemble(dir: string, target: 'chrome' | 'firefox') {
  rmSync(dir, { recursive: true, force: true })
  mkdirSync(dir, { recursive: true })
  for (const entry of ['lib', 'icons', 'sw.js', 'popup.html', 'popup.js', 'options.html', 'options.js', 'ui.js', 'theme.js', 'app.css']) {
    cpSync(join(src, entry), join(dir, entry), { recursive: true })
  }
  mkdirSync(join(dir, 'tailor'))
  for (const entry of ['tokens.css', 'base.css', 'layout.css', 'tailor.js', 'icons.svg', 'skins', 'palettes']) {
    cpSync(join(tailor, entry), join(dir, 'tailor', entry), { recursive: true })
  }
  writeFileSync(join(dir, 'tailor/config.js'), `// generated by bin/build-extension from public/tailor/tailor-head.html\nwindow.TAILOR_CONFIG = ${JSON.stringify(config)}\n`)
  const m = structuredClone(manifest)
  if (target === 'chrome' && publicKey) m.key = publicKey
  if (target === 'firefox') {
    m.background = { scripts: ['sw.js'], type: 'module' }
    // The extension sends nothing anywhere but to the hatchery the user sets.
    m.browser_specific_settings = { gecko: { id: GECKO_ID, strict_min_version: '128.0', data_collection_permissions: { required: ['none'] } } }
  }
  writeFileSync(join(dir, 'manifest.json'), `${JSON.stringify(m, null, 2)}\n`)
}

const chromeDir = join(out, 'chrome', NAME)
const firefoxDir = join(out, 'firefox')
assemble(chromeDir, 'chrome')
assemble(firefoxDir, 'firefox')
// Policy scripts: the extension ID becomes their default, so they work without --id for this build.
rmSync(join(out, 'policy'), { recursive: true, force: true })
mkdirSync(join(out, 'policy'), { recursive: true })
for (const f of readdirSync(join(src, 'policy'))) {
  const text = readFileSync(join(src, 'policy', f), 'utf8').replaceAll('__EXTENSION_ID__', extensionId || '__EXTENSION_ID__')
  writeFileSync(join(out, 'policy', f), text, { mode: f.endsWith('.sh') ? 0o755 : 0o644 })
}

if (crx) await packCrx()

if (noZip) {
  console.log(`built ${NAME} ${manifest.version} (no zips):\n  ${chromeDir}\n  ${firefoxDir}`)
  process.exit(0)
}
rmSync(join(out, `${NAME}-chrome.zip`), { force: true })
rmSync(join(out, `${NAME}-firefox.zip`), { force: true })
await $`zip -qrX ${join(out, `${NAME}-chrome.zip`)} ${NAME}`.cwd(join(out, 'chrome'))
await $`zip -qrX ${join(out, `${NAME}-firefox.zip`)} .`.cwd(firefoxDir)
console.log(`built ${NAME} ${manifest.version}:\n  ${join(out, `${NAME}-chrome.zip`)}\n  ${join(out, `${NAME}-firefox.zip`)}`)

/** Chrome or Chromium: CHROME, then the usual names on PATH, then a Playwright download. */
function findChrome(): string {
  if (process.env.CHROME) return process.env.CHROME
  for (const name of ['google-chrome', 'google-chrome-stable', 'chromium', 'chromium-browser']) {
    const p = Bun.which(name)
    if (p) return p
  }
  const pw = join(homedir(), '.cache/ms-playwright')
  if (existsSync(pw)) {
    for (const d of readdirSync(pw).filter((x) => /^chromium-\d+$/.test(x)).sort().reverse()) {
      const p = join(pw, d, 'chrome-linux64/chrome')
      if (existsSync(p)) return p
    }
  }
  throw new Error('--crx needs Chrome or Chromium: set CHROME to its binary')
}

/** Chrome's own packer signs the unpacked build; it writes <dir>.crx next to the folder. */
async function packCrx() {
  const chrome = findChrome()
  const profile = join(tmpdir(), `${NAME}-pack-${process.pid}`)
  const packed = `${chromeDir}.crx`
  rmSync(packed, { force: true })
  await $`${chrome} --headless=new --no-sandbox --user-data-dir=${profile} --pack-extension=${chromeDir} --pack-extension-key=${keyPath}`.quiet().nothrow()
  rmSync(profile, { recursive: true, force: true })
  if (!existsSync(packed)) throw new Error(`Chrome did not pack ${chromeDir}`)
  renameSync(packed, join(out, `${NAME}.crx`))
  chmodSync(join(out, `${NAME}.crx`), 0o644)
  console.log(`packed ${join(out, `${NAME}.crx`)} (extension ID ${extensionId})`)
}
