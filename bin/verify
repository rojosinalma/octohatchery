#!/usr/bin/env bash
# Verifies the project: dependencies, types, tests, and (optionally) a health probe from a container.
# Usage: bin/verify            — install, typecheck, test
#        VERIFY_URL=https://host bin/verify — also probes $VERIFY_URL/health from a curl container (never loopback);
#        VERIFY_NETWORK=<docker network> and VERIFY_HOST=<name:ip> help the probe reach LAN-only names
set -euo pipefail
cd "$(dirname "$0")/.."

step() { printf '\n==> %s\n' "$*"; }

# Nothing private reaches the repository, tests and fixtures included: built-in patterns for local paths, private
# addresses and LAN-only names, plus the untracked per-clone list in .git/info/leak-patterns (one extended regex
# per line, `#` comments, matched case-insensitively). OCTOHATCHERY_LEAK_PATTERNS points at another list.
step "leak scan"
patterns=(
  '/home/[a-z_][a-z0-9_-]*/'
  '\b10\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\b'
  '\b192\.168\.[0-9]{1,3}\.[0-9]{1,3}\b'
  '\b[a-z0-9-]+\.(internal|lan|local)\b'
)
extra="${OCTOHATCHERY_LEAK_PATTERNS:-$(git rev-parse --git-path info/leak-patterns 2>/dev/null || true)}"
if [ -n "$extra" ] && [ -f "$extra" ]; then
  while IFS= read -r p; do [ -n "$p" ] && [ "${p#\#}" = "$p" ] && patterns+=("$p"); done < "$extra"
fi
# Generic hits that are not private: the runner image's own home, the example domain, the vendored tailor files,
# and reverse-proxy products named in the docs.
allow='/home/runner/|example\.internal|^public/tailor/|Authentik'
leaks=0
if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  for p in "${patterns[@]}"; do
    hits=$(git grep -nIiE -e "$p" -- . ':!LICENSE' ':!*.lock' ':!bin/verify' 2>/dev/null | grep -vE "$allow" || true)
    if [ -n "$hits" ]; then echo "possible leak:"$'\n'"$hits" >&2; leaks=$((leaks + 1)); fi
  done
  [ "$leaks" -eq 0 ] || { echo "verify: $leaks leak pattern(s) matched; replace the private value with a neutral one" >&2; exit 1; }
else
  echo "not a git checkout: skipped"
fi

step "bun install --frozen-lockfile"
bun install --frozen-lockfile

step "bunx tsc --noEmit"
bunx tsc --noEmit

# Each test area runs in its own process: Bun's mock.module() is process-wide and the
# mcp/ui suites replace src/lib/service, which would leak into the core suite.
for area in test/*/; do
  ls "$area"*.test.ts >/dev/null 2>&1 || continue # fixtures and helpers only
  step "bun test ${area%/}"
  bun test "${area%/}"
done

if [ -n "${VERIFY_URL:-}" ]; then
  step "probe ${VERIFY_URL%/}/health"
  # VERIFY_NETWORK joins the proxy's docker network, VERIFY_HOST=name:ip pins a LAN-only name; both optional.
  net=(); [ -n "${VERIFY_NETWORK:-}" ] && net=(--network "$VERIFY_NETWORK")
  host=(); [ -n "${VERIFY_HOST:-}" ] && host=(--add-host "$VERIFY_HOST")
  docker run --rm "${net[@]}" "${host[@]}" curlimages/curl:8.17.0 --fail --silent --show-error --insecure --max-time 15 "${VERIFY_URL%/}/health"
  echo
fi

step "all checks passed"
