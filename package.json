{
  "name": "octohatchery",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "bunx tsc --noEmit",
    "test": "for d in test/*/; do ls \"$d\"*.test.ts >/dev/null 2>&1 || continue; bun test \"$d\" || exit 1; done",
    "db:generate": "drizzle-kit generate",
    "verify": "bin/verify"
  },
  "devDependencies": {
    "@kitajs/ts-html-plugin": "4.1.4",
    "@types/bun": "1.4.3",
    "@types/dockerode": "4.0.2",
    "drizzle-kit": "0.31.11",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@elysiajs/html": "1.4.2",
    "@kitajs/html": "4.2.13",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@octokit/app": "16.1.4",
    "@octokit/rest": "22.0.1",
    "@octokit/webhooks-methods": "6.0.0",
    "dockerode": "5.0.1",
    "drizzle-orm": "0.45.4",
    "elysia": "1.4.30",
    "postgres": "3.4.9",
    "prom-client": "15.1.3",
    "zod": "4.6.7"
  },
  "version": "0.3.0",
  "description": "Orchestrator for self-hosted GitHub Actions runners: one ephemeral runner per job, typed, across hosts.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/rojosinalma/octohatchery.git"
  }
}
